{
  "name": "bf-pdf-editor",
  "version": "0.1.0",
  "description": "Enterprise-Grade PDF Editor für Linux (Fedora, Wayland/X11) mit konfigurierbarer KI-Unterstützung.",
  "homepage": "https://example.org/pdf-editor",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26"
  },
  "desktopName": "pdf-editor.desktop",
  "author": "B&F",
  "license": "MIT",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:backend": "python -m PyInstaller --noconfirm --clean --distpath dist/backend --workpath dist/build-pyi backend/backend.spec",
    "build:app": "electron-builder --linux",
    "package": "bash scripts/build.sh",
    "pipeline": "bash scripts/build-pipeline.sh",
    "pipeline:release": "bash scripts/build-pipeline.sh --e2e --install",
    "test:e2e": "playwright test",
    "test:e2e:browser": "E2E_BROWSER=1 playwright test --project=browser",
    "build:dir": "electron-builder --linux --dir",
    "ui-registry": "node scripts/ui-registry.mjs",
    "tooltip-coverage": "node scripts/tooltip-coverage.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "axios": "^1.7.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-log": "^5.4.4",
    "immer": "^10.2.0",
    "lucide-react": "^0.469.0",
    "pdfjs-dist": "4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.19.30",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.0",
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.1",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
